# Spark backend — environment configuration (copy to .env)

# Anthropic / Claude. If unset, the reasoning layer falls back to a
# deterministic mock so the whole app stays runnable and testable.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MODEL_HARD=claude-opus-4-8

# Integrations: "stub" uses bundled sample data; "live" would call real APIs.
INTEGRATIONS_MODE=stub

# Zoho CRM (used only when INTEGRATIONS_MODE=live)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_API_DOMAIN=https://www.zohoapis.com

# Argus telematics (used only when INTEGRATIONS_MODE=live)
ARGUS_BASE_URL=
ARGUS_API_KEY=

# Decision routing thresholds
CONFIDENCE_REVIEW_THRESHOLD=0.75
AUTO_APPROVE_THRESHOLD=0.90

# Database
DATABASE_URL=sqlite:///./spark.db
